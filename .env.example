# --- Wallet + policy gateway (server-side only; never ship to the browser) ---
RELAYER_API_KEY=
SPONSOR_SECRET_KEY=
GATEWAY_PORT=8787
GATEWAY_ALLOWED_ORIGIN=http://localhost:5173

# --- Stellar / Soroban (testnet) ---
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# --- x402 facilitator (self-hosted: default hosted ceiling of 50000 stroops
# is too low for a policy-governed payment running inside __check_auth) ---
FACILITATOR_URL=http://localhost:8788
FACILITATOR_MAX_FEE_STROOPS=500000

# A funded classic G-account used ONLY as the x402 simulation source.
# Never charged, signs nothing.
X402_SIMULATION_SOURCE_ACCOUNT=
